{
  "name": "formandos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node db/migrate.mjs --if-configured",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:schema": "node --env-file-if-exists=.env.local db/apply-schema.mjs",
    "db:seed": "node --env-file-if-exists=.env.local db/seed.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.6",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
