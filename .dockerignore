# Contexto de build: sem isto, o daemon envia node_modules, .next, .git e um
# PDF de 275 KB a cada `docker compose build`.
node_modules
.next
out
coverage

# Segredos: o build nunca precisa de .env* (as variáveis chegam em runtime).
.env*
!.env.example

.git
.gitignore
.gitattributes

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Documentação e artefatos que o runtime não usa.
docs/*.pdf
docs/image.png
docs/guia-de-estudo.md
docs/entregas
README.md
CLAUDE.md
AGENTS.md
.claude

# Teste de navegador (precisa de Chrome local, roda fora do container).
scripts/teste