# Copie para .env.local e preencha. Nunca comite o .env.local.
DATABASE_URL="postgres://usuario:senha@localhost:5432/formandos"

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs e servicos > Credenciais
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Opcional: máximo de conexões por instância (padrão 5).
# DB_POOL_MAX=5

# Em produção (ver docs/deploy.md):
# - DATABASE_URL termina com ?sslmode=require
# - BETTER_AUTH_URL é a URL pública, ex.: https://formandos.vercel.app
# - use um BETTER_AUTH_SECRET novo, diferente do desenvolvimento
