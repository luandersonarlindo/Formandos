# Copie para .env.local e preencha. Nunca comite o .env.local.
# No deploy (Vercel), as mesmas variáveis vão no painel do projeto
# (Settings > Environment Variables). O .env.local NÃO sobe para a nuvem.

# Conexão do app em tempo de execução. Use a string com "-pooler" do Neon: a
# Vercel sobe várias instâncias do app ao mesmo tempo e cada uma abriria um
# conjunto de conexões; o pooler é o que aguenta isso. Copie do painel do Neon
# marcando "Pooled connection" (conexão com pool).
DATABASE_URL="postgres://USUARIO:SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Só para migração (cria as tabelas). Precisa da string SEM "-pooler", porque o
# pooler do Neon é PgBouncer em modo transação e não aceita DDL. Não é usada em
# tempo de execução: pode remover depois de aplicar a migração.
MIGRATION_DATABASE_URL="postgres://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Gere com: openssl rand -base64 32
# Precisa ser o MESMO valor em todas as variáveis de ambiente da Vercel: trocar
# a chave invalida todas as sessões e o cookie de login cai.
BETTER_AUTH_SECRET=""

# Endereço público do app. É daqui que saem o redirect URI do Google, os links de
# email e a origem que o Better Auth considera confiável.
# Em desenvolvimento, http://localhost:3000.
# Em produção, https://formandos.vercel.app (sem barra no final).
BETTER_AUTH_URL="http://localhost:3000"

# Opcional: acessar pelo IP da rede local (celular, tablet, TV) além do
# endereço acima. Descubra o IP com `hostname -I` (Linux/Mac) ou `ipconfig`
# (Windows) e use a mesma porta do `npm run dev` (3000). Sem isso o Next e o
# Better Auth recusam requisições vindas de um host que não seja "localhost".
# Não defina na Vercel: lá o acesso é sempre pelo endereço público.
# LAN_ORIGIN="http://SEU-IP-LOCAL:3000"

# Google Cloud Console > APIs e servicos > Credenciais > "ID do cliente OAuth 2.0".
# Em "URIs de redirecionamento autorizados" cadastre EXATAMENTE:
#   https://formandos.vercel.app/api/auth/callback/google
# O Google não aceita o padrão "*.vercel.app", então o botão só funciona em
# produção. O código desliga o Google nos previews da Vercel de propósito.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Administradores master (gestores de toda a plataforma): emails separados por
# vírgula. Precisam ter o email confirmado. Sem isso, ninguém acessa /master.
ADMIN_MASTER_EMAILS=""

# Opcional: máximo de conexões do Pool por instância (padrão 5). Na Vercel, cada
# instância tem o seu próprio pool; deixe baixo para não estourar o limite do
# plano do Neon.
# DB_POOL_MAX=5


# Envio de email (confirmação de conta, redefinir senha, boas-vindas).
# Com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu@gmail.com,
# SMTP_PASS=<senha de app>, gerada em myaccount.google.com/apppasswords
# (exige verificação em duas etapas). Sem SMTP_HOST, os emails aparecem só no
# terminal do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Formandos <seu@gmail.com>"