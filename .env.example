# Copie para .env.local e preencha. Nunca comite o .env.local.
DATABASE_URL="postgres://usuario:senha@localhost:5432/formandos"

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Opcional: acessar pelo IP da rede local (celular, tablet, TV). Descubra o
# IP com `hostname -I` (Linux/Mac) ou `ipconfig` (Windows) e use a mesma
# porta do `npm run dev` (3000). Sem isso o Next e o Better Auth recusam
# requisições vindas de um host que não seja "localhost".
# LAN_ORIGIN="http://10.0.0.112:3000"

# Google Cloud Console > APIs e servicos > Credenciais
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Administradores master (gestores de toda a plataforma): emails separados por
# vírgula. Precisam ter o email confirmado. Sem isso, ninguém acessa /master.
ADMIN_MASTER_EMAILS=""

# Opcional: máximo de conexões por instância (padrão 5).
# DB_POOL_MAX=5


# Envio de email (confirmação de conta, redefinir senha, boas-vindas).
# Com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu@gmail.com,
# SMTP_PASS=<senha de app>, gerada em myaccount.google.com/apppasswords
# (exige verificação em duas etapas). Sem SMTP_HOST, os emails aparecem só no
# terminal do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Formandos <seu@gmail.com>"
